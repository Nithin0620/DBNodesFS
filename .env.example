NODE_ENV=development
LOG_LEVEL=debug

COORDINATOR_PORT=4000

MONGO_URI=mongodb://localhost:27017/dbnodesfs
REDIS_URL=redis://localhost:6379

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks_current

EMBEDDER_URL=http://localhost:8000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

CHUNK_SIZE_BYTES=4194304
REPLICATION_FACTOR=3
NODE_HEARTBEAT_INTERVAL_MS=5000
NODE_HEARTBEAT_TIMEOUT_MS=15000

STORAGE_NODE_ID=node-1
STORAGE_NODE_PORT=5001
STORAGE_NODE_DATA_DIR=./data
